# Normalize text files to LF in the repository and working tree (the code runs in Linux containers).
* text=auto eol=lf

# Rendered diagrams (SVG is XML text) and their Mermaid sources stay LF text.
*.svg text eol=lf
*.mmd text eol=lf

# Windows-only scripts keep CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary artifacts.
*.png binary
*.jpg binary
*.fmu binary
*.ssp binary
*.zip binary
*.mat binary
